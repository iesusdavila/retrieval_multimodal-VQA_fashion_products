mbeddings de imagen (t-SNE 3D) — por subCategory\", \"emb3d_sub_tsne.png\")\nplot_3d_plotly(coords_img_tsne, viz_meta[\"subCategory\"], viz_hover,\n               \"Embeddings de imagen (t-SNE 3D) — subCategory\", \"emb3d_sub_tsne.html\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T15:46:08.299491Z","iopub.execute_input":"2026-09-20T15:46:08.299849Z","iopub.status.idle":"2026-09-20T15:47:19.841427Z","shell.execute_reply.started":"2026-09-20T15:46:08.299811Z","shell.execute_reply":"2026-09-20T15:47:19.840688Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"joint_n = min(1500, viz_n)\njoint = np.concatenate([viz_img[:joint_n], viz_txt[:joint_n]], axis=0)\ncoords_joint = project_3d(joint, \"pca\")\nmodality = [\"imagen\"] * joint_n + [\"texto\"] * joint_n\njoint_hover = viz_hover[:joint_n] * 2\n\nplot_3d_matplotlib(coords_joint, modality,\n                   \"Espacio conjunto imagen + texto (PCA 3D)\", \"emb3d_joint_pca.png\", point_size=3)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T15:47:19.842469Z","iopub.execute_input":"2026-09-20T15:47:19.842718Z","iopub.status.idle":"2026-09-20T15:47:21.304079Z","shell.execute_reply.started":"2026-09-20T15:47:19.842694Z","shell.execute_reply":"2026-09-20T15:47:21.303269Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"fig = go.Figure()\nfor name, sl, color in [(\"imagen\", slice(0, joint_n), \"#2b6cb0\"), (\"texto\", slice(joint_n, None), \"#c05621\")]:\n    c = coords_joint[sl]\n    fig.add_trace(go.Scatter3d(x=c[:, 0], y=c[:, 1], z=c[:, 2], mode=\"markers\", name=name,\n                               marker=dict(size=2.6, color=color, opacity=0.7),\n                               text=viz_hover[:joint_n], hoverinfo=\"text+name\"))\n\nlink_idx = np.random.RandomState(0).choice(joint_n, 60, replace=False)\nfor i in link_idx:\n    a, b = coords_joint[i], coords_joint[joint_n + i]\n    fig.add_trace(go.Scatter3d(x=[a[0], b[0]], y=